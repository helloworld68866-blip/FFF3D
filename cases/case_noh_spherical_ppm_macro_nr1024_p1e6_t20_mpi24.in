# case_noh_spherical_ppm_macro_nr1024_p1e6_t20_mpi24.in：严格球对称 Noh H-only 验证算例控制文件
[run] # 运行控制区
case_name = case_noh_spherical_ppm_macro_nr1024_p1e6_t20_mpi24 # 算例名称
phase = P5 # 使用 P5 输入入口
stage_order = H # 只执行水动力 H 阶段
step_count = 20 # 运行 20 个 CFL 时间步
dt_mode = hydro_relaxed # 时间步由 hydro CFL 估计
cfl = 0.50 # Noh 验证使用 CFL=0.5
output_dir = analysis/output/case_noh_spherical_ppm_macro_nr1024_p1e6_t20_mpi24 # 输出目录

[mesh] # 网格控制区
geometry = spherical # 使用球坐标网格
radial_cells = 1024 # 径向网格数
theta_cells = 8 # 极角网格数
phi_cells = 8 # 方位角网格数
radial_min_cm = 0.0 # 内半径，单位 cm
radial_max_cm = 1.0 # 外半径，单位 cm
theta_min = 0.0 # theta 下界
theta_max = 3.141592653589793 # theta 上界
phi_min = 0.0 # phi 下界
phi_max = 6.283185307179586 # phi 上界
moving_mesh = false # 本验证关闭 ALE moving mesh
macro_zoning = true # 启用 macro-zoning 和 PPM hydro 路径

[initial_condition] # 初值控制区
profile_interpolation = linear # 径向 profile 使用线性插值
profile_radius_unit = um # profile 半径单位为微米
outside_profile_policy = hard_fail # profile 不覆盖网格时直接失败

[perturbation] # 初始扰动控制区
enabled = false # Noh 球对称验证不加扰动
type = none # 无扰动类型占位
ell = 0 # 无扰动时球谐阶数为 0
m = 0 # 无扰动时方位模数为 0
amplitude = 0.0 # 无扰动振幅
target = none # 无扰动目标字段

[physics] # 物理模块开关区
enable_hydro = true # 启用 H 阶段
enable_thermal = false # 关闭 T 阶段
enable_equilibration = false # 关闭 E 阶段
enable_radiation = false # 关闭 R 阶段
enable_alpha = false # 关闭 A 阶段

[radiation] # 辐射初始化占位区
group_mode = explicit_frequency_groups # 使用显式频群布局以满足初始化器合同
group_edges_eV = 1,10 # H-only 验证只需要一个占位辐射群
opacity_provider = tops_dt_tabulated # provider 占位，H-only 不执行 R 阶段
radiation_initialization = zero # 辐射初值置零
radiation_initial_blackbody_scale = 1.0 # 黑体缩放占位
boundary_model = thesis_marshak_vacuum # 辐射边界占位，H-only 不执行
flux_limiter = harmonic_eq_5_209 # 辐射 limiter 占位，H-only 不执行

[thermal] # 热传导配置占位区
kappa_model = lee_more_with_degeneracy # 热传导模型占位，H-only 不执行
electron_flux_limiter = minmax_old_time_face_effective_kappa # 电子热流 limiter 占位，H-only 不执行

[alpha] # alpha 配置占位区
composition_model = equimolar_dt_from_p2_recovery # 等摩尔 DT closure 占位
reactivity_model = bosch_hale_dt # 反应率模型占位，H-only 不执行
alpha_initialization = zero # alpha 初值置零

[boundaries] # 边界条件区
inner_radial = scalar_origin_remap_required # 原点使用 scalar origin remap
outer_radial = noh_exact_inflow # 外边界使用严格 spherical Noh exact inflow ghost
theta = scalar_pole_remap_required # 极点使用 scalar pole remap
phi = periodic # 方位角周期边界

[output] # 输出控制区
write_profiles_every = 0 # 不写旧 profile 输出
write_diagnostics_every = 0 # 不写旧 diagnostics 输出
write_restart_every = 0 # 不写旧 restart 输出
write_dec3d_out_every_steps = 1 # 每步记录 dec3d.out
field_checkpoint_every_steps = 0 # 不按步数写常规 checkpoint
field_checkpoint_interval_s = 0.0 # 不按模拟时间写常规 checkpoint
field_checkpoint_prefix = fields # 常规 checkpoint 前缀占位
field_checkpoint_format = csv3d # 常规 checkpoint 格式占位
restart_checkpoint_every_steps = 0 # 不按步数写 restart checkpoint
restart_checkpoint_interval_s = 0.0 # 不按模拟时间写 restart checkpoint
restart_checkpoint_prefix = restart # restart checkpoint 前缀占位
restart_checkpoint_format = dec3d_restart_text # restart checkpoint 格式占位
